# These are NOT loaded from a .env file at runtime — Cloud Functions v2
# secrets are managed via Secret Manager and set with the Firebase CLI:
#
#   firebase functions:secrets:set GOOGLE_SHEETS_CLIENT_EMAIL
#   firebase functions:secrets:set GOOGLE_SHEETS_PRIVATE_KEY
#   firebase functions:secrets:set GOOGLE_SHEET_ID
#
# This file exists purely as a reference for local emulator development
# (copy to .env.local, which the emulator reads) and to document what
# each range var controls. The non-secret RANGE_* vars can also be
# overridden for a real deploy via functions/.env.<project-id> — see
# README.md.

# Service account client_email from the downloaded JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private_key from the downloaded JSON key.
# Keep the literal \n sequences — normalizePrivateKey() converts them.
GOOGLE_SHEETS_PRIVATE_KEY=

# The Sheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# --- Sub-score table ranges (defaults shown — override if your tab/column
# layout differs from what was inferred from screenshots) -----------------
RANGE_WESTERN_SUN=Western Zodiac!B1:D500
RANGE_WESTERN_MOON=Western Zodiac!F1:H500
RANGE_WESTERN_RISING=Western Zodiac!J1:L500
RANGE_CHINESE_ANIMAL=Chinese Zodiac!B1:D500
RANGE_CHINESE_ELEMENT=Chinese Zodiac!F1:H500
RANGE_CHINESE_YIN_YANG=Chinese Zodiac!J1:L500

# --- Overall insights library ---------------------------------------------
RANGE_INSIGHTS_LIBRARY=Compatibility Insights Library!A1:L30

# --- Per-factor tiered insights (tab names are a guess — verify) ---------
RANGE_SUN_INSIGHTS=Sun Sign Insights!A1:B10
RANGE_MOON_INSIGHTS=Moon Sign Insights!A1:B10
RANGE_RISING_INSIGHTS=Rising Sign Insights!A1:B10
RANGE_ANIMAL_INSIGHTS=Animal Insights!A1:B10
RANGE_ELEMENT_INSIGHTS=Heavenly Stem Insights!A1:B10
RANGE_YIN_YANG_INSIGHTS=Yin Yang Insights!A1:B10

# --- Operational config ----------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=300

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe Identity publishable key (real face/document verification).
# Get this from https://dashboard.stripe.com/apikeys once Identity is
# enabled — see functions/.env.example for the matching secret-key setup.
# Verification is unavailable in the UI until this AND the backend secrets
# are set (no fake fallback).
VITE_STRIPE_PUBLISHABLE_KEY=

# Web Push certificate key pair (VAPID) for real push notifications while
# the app is closed/backgrounded, via Firebase Cloud Messaging. Get this
# from Firebase Console -> Project Settings -> Cloud Messaging -> Web
# configuration -> "Generate key pair". The notification banner still lets
# members grant foreground browser notification permission without this
# set, but background push (FCM token registration) is unavailable until
# it is — no fake "connected" state shown either way.
VITE_FIREBASE_VAPID_KEY=

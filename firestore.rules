rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Order-independent match id, e.g. matchId("b","a") == "a_b" — lets a
    // rule check "does a real match exist between these two uids" without
    // knowing which order the match doc used.
    function matchId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Each member's own account doc: onboarding data, likes/passes/matches.
    // Any signed-in member can READ any other member's doc — real Discovery/
    // ProfileDetail browsing needs to see other people's profile fields.
    // Firestore rules can't restrict by field, so most fields here are
    // technically readable by anyone signed in; acceptable at pre-launch
    // scale for non-sensitive fields (no PII beyond other uids, not
    // enumerable). Anything actually sensitive (lifestyle) lives in the
    // gated private/ subcollection below instead of on this doc.
    //
    // Writes: the owner can create/update their own doc, but can NEVER
    // touch verification, likedIds, or matchedIds themselves — those are
    // written exclusively by the Admin SDK (the Stripe Identity webhook and
    // the likeUser Cloud Function). Without this, a member could write
    // `verification.status: 'verified'` or a fabricated `matchedIds` entry
    // straight into their own doc from the browser console.
    //
    // Birth fields (date/time/place + everything derived from them for the
    // astrology/compatibility engine) can be written ONCE — the Birth
    // Details onboarding screen — and are then locked: once `birthCity` is
    // set, no further client write to any of these fields is allowed, since
    // the UI promises "locked after confirmation, contact support to
    // change" and that has to be real, not just a claim in the copy.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification', 'likedIds', 'matchedIds'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'birthDate', 'birthTime', 'birthTimeUnknown', 'birthPlace',
            'birthCountry', 'birthCity', 'birthPlaceLat', 'birthPlaceLon',
            'sunSign', 'moonSign', 'risingSign', 'chineseAnimal', 'chineseElement', 'yinYang'
          ])
          || !('birthCity' in resource.data) || resource.data.birthCity == ''
        );
      allow delete: if false; // only the deleteAccount Cloud Function (Admin SDK)
    }

    // Sensitive profile fields a member has explicitly chosen to keep
    // private or matches-only (currently: lifestyle). Only the owner, or —
    // when the member chose "matching-only" — someone with a real, existing
    // match with them can read it. "private" is never readable by anyone
    // but the owner, enforced here rather than just hidden in the UI.
    match /users/{uid}/private/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        resource.data.visibility == 'public' ||
        (resource.data.visibility == 'matching-only' &&
          exists(/databases/$(database)/documents/matches/$(matchId(uid, request.auth.uid))))
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Real mutual-like matching. The client can never read another user's
    // likes (it already knows its own via users/{uid}.likedIds) and can
    // never write either collection directly — only the likeUser Cloud
    // Function (Admin SDK) creates a like or a match, after genuinely
    // checking for reciprocity server-side. This is what makes it
    // impossible to fake a match from the client.
    match /likes/{likeId} {
      allow read, write: if false;
    }
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow write: if false;
    }

    // Conversations are keyed by matchId and only ever created by the
    // likeUser Cloud Function alongside the match itself (so every real
    // match has exactly one conversation from the start). Both real
    // participants — not just one — can read the conversation and their
    // shared messages, and only ever as themselves as sender.
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow write: if false;
    }
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        && request.resource.data.senderId == request.auth.uid;
      // Real read receipts: only the RECIPIENT (never the sender) can mark a
      // message read, and only that one field — they can't edit its content.
      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        && request.auth.uid != resource.data.senderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Real uploaded media (photos/videos). Any signed-in member can view
    // (profile browsing), but only the owner can create/update/delete their
    // own items. The video-processing Cloud Function writes processed
    // variants via the Admin SDK, which bypasses these rules entirely.
    match /media/{mediaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // --- Perennia Compatibility Fusion System -------------------------
    // Proprietary data. The client SDK must NEVER read or write these
    // collections under any condition — every access goes through the
    // getCompatibility / sync Cloud Functions, which use the Admin SDK
    // and bypass these rules entirely. The explicit `allow ... if false`
    // is intentional belt-and-braces: even if a future rule change above
    // adds a broad catch-all match, these stay locked.

    match /fusionSunScores/{pairKey} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionMoonScores/{pairKey} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionRisingScores/{pairKey} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionAnimalScores/{pairKey} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionElementScores/{pairKey} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionYinYangScores/{pairKey} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionInsightsLibrary/{bucketId} {
      allow read: if false;
      allow write: if false;
    }
    match /fusionFactorInsights/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /rateLimits/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // Birth-details edit re-verification (OTP state) — Admin SDK only, see
    // functions/src/services/birthDetailsReverification.service.ts.
    match /birthDetailsReverification/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // --- Founding 500 membership --------------------------------------
    // Config is public (the pricing page is shown pre-auth) but only ever
    // written via the Admin SDK / admin-only callables — never directly by
    // clients, so pricing/availability can't be tampered with client-side.
    match /config/founding500 {
      allow read: if true;
      allow write: if false;
    }

    // The single source of truth for "is this a real Founding 500 member" —
    // written exclusively by the post-payment Stripe webhook. A member can
    // read their own record (to show their certificate/badge) but can never
    // write it — this is what makes it impossible to fake membership from
    // the client.
    match /foundingMembers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
